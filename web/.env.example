# Secret the external hourly scheduler must send to /api/evaluate.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Gmail SMTP (same app-password scheme as the old run_local.ps1 runner).
KRAMM_GMAIL_USER=
KRAMM_GMAIL_APP_PW=
# Optional, defaults to KRAMM_GMAIL_USER if unset.
KRAMM_ALERT_EMAIL_TO=

# Set automatically by the Vercel "Upstash Redis" Marketplace integration --
# you normally don't need to set these by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
